#pragma once
// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored - never commit real credentials.

#define WIFI_SSID   "your-wifi"
#define WIFI_PASS   "your-password"

// Required in the X-Api-Token header for all write requests (POST /rooms/<id>).
#define API_TOKEN   "change-me"

// MQTT broker credentials, used only when MQTT_REQUIRE_AUTH is 1 in config.h.
// Watts Live cannot do TLS, so these cross the LAN in clear text.
#define MQTT_USER   "wavin"
#define MQTT_PASS   "change-me"
